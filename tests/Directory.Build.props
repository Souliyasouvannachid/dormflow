<Project>

  <!-- ສືບທອດມູນຄ່າຈາກ Directory.Build.props ທີ່ root -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- .NET 10 SDK ຢຸດສະຜັບສະຜູນ VSTest ຫຼັງຈາກນັ້ນ, ທ່ານຕ້ອງດໍາເນີນການ dotnet test ຜ່ານ Microsoft Testing Platform -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- ການທົດສອບໂຄງການບໍ່ເປີດ TreatWarningsAsErrors -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      CA1707 ອະນຸຍາດໃຫ້ມີຊື່ທົດສອບທີ່ມີຂີດກ້ອງ
      CA2007 ບໍ່ຕ້ອງ ConfigureAwait ໃນການທົດສອບ
      CA1861 ອະເຣຄົງທີ່ແມ່ນອະນຸຍາດໃຫ້ຢູ່ໃນອາກິວເມັນທົດສອບ
      CA1859 ທົດສອບການໂທຜ່ານ interface ຕັ້ງໃຈເພາະວ່າສິ່ງທີ່ຖືກທົດສອບແມ່ນຄໍາສັນຍາຂອງ interface ບໍ່ແມ່ນຫ້ອງຮຽນນັ້ນ implement
    -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA1859</NoWarn>
  </PropertyGroup>

</Project>
