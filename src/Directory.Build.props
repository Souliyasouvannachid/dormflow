<Project>

  <!-- ສືບທອດມູນຄ່າຈາກ Directory.Build.props ທີ່ root -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      ເປີດ TreatWarningsAsErrors ລະຫັດເທົ່ານັ້ນ Production ເທົ່ານັ້ນ
      ການທົດສອບໂຄງການບໍ່ໄດ້ເປີດເນື່ອງຈາກວ່າ analyzer ຂອງ test framework ເຕືອນສະເຝີໃນກໍລະນີທີ່ຍອມຮັບໄດ້
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
