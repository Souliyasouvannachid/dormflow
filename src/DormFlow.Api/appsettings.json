{
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "//": "ห้ามใส่ค่าจริงในไฟล์นี้ กำหนดผ่าน environment variable ชื่อ ConnectionStrings__DefaultConnection",
    "DefaultConnection": ""
  },

  "Https": {
    "//": "ปิดเมื่อรันหลัง reverse proxy ที่จัดการ TLS ให้แล้ว",
    "EnableRedirection": true
  },

  "Database": {
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "AutoMigrate": false,
    "SeedOnStartup": true
  },

  "BackgroundJobs": {
    "//": "ปิดได้โดยไม่ต้อง deploy ใหม่ เผื่อกรณีต้องการหยุด Background Job ทั้งหมดชั่วคราว",
    "Enabled": true
  },

  "Jwt": {
    "//": "ห้ามใส่ SigningKey จริงในไฟล์นี้ กำหนดผ่าน environment variable ชื่อ Jwt__SigningKey เท่านั้น",
    "SigningKey": "",
    "Issuer": "DormFlow",
    "Audience": "DormFlow.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 0
  },

  "Email": {
    "FromAddress": "no-reply@dormflow.local",
    "FromName": "DormFlow",
    "PickupDirectory": "logs/emails"
  },

  "Api": {
    "Title": "DormFlow API",
    "Description": "ระบบบริหารจัดการหอพักและอพาร์ตเมนต์แบบหลายองค์กร",
    "ContactName": "DormFlow Team",
    "ContactEmail": "support@dormflow.local"
  },

  "Cors": {
    "//": "ต้องระบุ Origin ที่อนุญาตเสมอใน Production ระบบจะไม่ยอมสตาร์ตถ้าปล่อยว่าง",
    "AllowedOrigins": []
  },

  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dormflow-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "DormFlow.Api"
    }
  }
}
