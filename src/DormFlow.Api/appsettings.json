{
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "//": "ຢ່າໃສ່ຄ່າຕົວຈິງໃນໄຟລ໌ນີ້. ກໍານົດຜ່ານ environment variable ຊື່ ConnectionStrings__DefaultConnection",
    "DefaultConnection": ""
  },

  "Https": {
    "//": "ປິດເມື່ອແລ່ນຫຼັງ reverse proxy ທີ່ຄຸ້ມຄອງ TLS ມອບໃຫ້ແລ້ວ",
    "EnableRedirection": true
  },

  "ForwardedHeaders": {
    "//": "ລະບຸ IP ຂອງ reverse proxy ທີ່ໄວ້ໃຈໄດ້ຜ່ານ ForwardedHeaders__KnownProxies__0 ເປັນຕົ້ນໄປ",
    "KnownProxies": []
  },

  "Database": {
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "AutoMigrate": false,
    "FailOnPendingMigrations": true,
    "SeedOnStartup": true
  },

  "BackgroundJobs": {
    "//": "ສາມາດປິດໄດ້ໂດຍບໍ່ມີການ deploy ໃໝ່ ໃນກໍລະນີທີ່ທ່ານຕ້ອງການຢຸດ Background Job ທັງຝົດຊົ່ວຄາວ",
    "Enabled": true
  },

  "Jwt": {
    "//": "ຢ່າໃສ່ SigningKey ຖືກຕ້ອງໃນໄຟລ໌ນີ້ກໍານົດໂດຍຜ່ານການ environment variable ຊື່ Jwt__SigningKey ເທົ່ານັ້ນ",
    "SigningKey": "",
    "Issuer": "DormFlow",
    "Audience": "DormFlow.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 0
  },

  "Email": {
    "Provider": "PickupDirectory",
    "FromAddress": "no-reply@dormflow.local",
    "FromName": "DormFlow",
    "PickupDirectory": "logs/emails"
  },

  "Api": {
    "Title": "DormFlow API ພາສາລາວ",
    "Description": "ລະບົບການຄຸ້ມຄອງຫໍພັກ ແລະອາພາດເມັນຫຼາຍອົງກອນ",
    "ContactName": "ທີມ DormFlow",
    "ContactEmail": "support@dormflow.local"
  },

  "Cors": {
    "//": "ຕ້ອງການ Origin ທີ່ອະນຸຍາດໃຫ້ຢູ່ໃນສະເຝີ Production ລະບົບຈະບໍ່ເລີ່ມຕົ້ນຖ້າປ່ອຍຫວ່າງໄວ້",
    "AllowedOrigins": []
  },

  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dormflow-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "DormFlow.Api"
    }
  }
}
