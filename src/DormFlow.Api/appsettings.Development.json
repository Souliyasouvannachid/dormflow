{
  "ConnectionStrings": {
    "//": "ค่าสำหรับ PostgreSQL ที่รันด้วย docker compose บนเครื่องนักพัฒนาเท่านั้น ห้ามใช้ค่าชุดนี้ที่อื่น",
    "DefaultConnection": "Host=localhost;Port=5432;Database=dormflow;Username=dormflow;Password=dormflow;Include Error Detail=true"
  },

  "Database": {
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true,
    "AutoMigrate": true
  },

  "Jwt": {
    "//": "กุญแจนี้ใช้บนเครื่องนักพัฒนาเท่านั้น ไม่ใช่ความลับจริง ห้ามใช้ค่านี้ใน Production เด็ดขาด",
    "SigningKey": "dormflow-local-development-signing-key-do-not-use-in-production"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:3000",
      "https://localhost:5173"
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
