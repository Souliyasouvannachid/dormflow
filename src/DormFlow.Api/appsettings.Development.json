{
  "ConnectionStrings": {
    "//": "ມູນຄ່າສໍາລັບ PostgreSQL ທີ່ດໍາເນີນການກັບ docker compose ພຽງແຕ່ຢູ່ໃນເຄື່ອງຈັກນັກພັດທະນາ ຢ່າໃຊ້ຊຸດຂອງຄ່ານີ້ຢູ່ບ່ອນອື່ນ",
    "DefaultConnection": "Host=localhost;Port=5432;Database=dormflow;Username=dormflow;Password=dormflow;Include Error Detail=true"
  },

  "Database": {
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true,
    "AutoMigrate": true
  },

  "Jwt": {
    "//": "ກະແຈນີ້ແມ່ນໃຊ້ໃນເຄື່ອງພັດທະນາເທົ່ານັ້ນ. ມັນບໍ່ແມ່ນຄວາມລັບແທ້ໆ. ຢ່າໃຊ້ຄ່ານີ້ໃນ Production ຢ່າງແທ້ຈິງ",
    "SigningKey": "dormflow-local-development-signing-key-do-not-use-in-production"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:3000",
      "https://localhost:5173"
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
