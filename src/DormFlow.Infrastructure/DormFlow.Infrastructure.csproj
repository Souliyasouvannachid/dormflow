<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DormFlow.Infrastructure</RootNamespace>
    <AssemblyName>DormFlow.Infrastructure</AssemblyName>
    <Description>Infrastructure layer - EF Core, PostgreSQL, Identity, JWT, Repository, Background Job, External Service</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DormFlow.Application\DormFlow.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- จำเป็นสำหรับ AddDefaultTokenProviders และส่วนขยายอื่นของ ASP.NET Core Identity ที่อยู่ใน shared framework ไม่ใช่ NuGet package -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <!-- ปักเวอร์ชันตรง ๆ เพื่อแก้ช่องโหว่ของ Newtonsoft.Json ที่ Hangfire.Core ดึงมาแบบ transitive -->
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

</Project>
