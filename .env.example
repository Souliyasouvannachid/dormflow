# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับสภาพแวดล้อมของคุณ
#   cp .env.example .env
# ห้าม commit ไฟล์ .env เข้า repository

# ---------- PostgreSQL ----------
POSTGRES_DB=dormflow
POSTGRES_USER=dormflow
# ตั้งรหัสผ่านที่คาดเดายากก่อนใช้งานจริง
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

# ---------- DormFlow API ----------
# ชื่อโฮสต์ dormflow-postgres คือชื่อ service ในเครือข่ายของ docker compose
ConnectionStrings__DefaultConnection=Host=dormflow-postgres;Port=5432;Database=dormflow;Username=dormflow;Password=change-this-password

ASPNETCORE_ENVIRONMENT=Production
API_HTTP_PORT=8080

# ---------- JWT ----------
# กุญแจเซ็น Access Token ต้องยาวอย่างน้อย 32 ตัวอักษรและสุ่มใหม่ทุกครั้ง ห้ามใช้ค่าตัวอย่างนี้จริง
#   openssl rand -base64 48
Jwt__SigningKey=change-this-to-a-long-random-value-at-least-32-characters
Jwt__Issuer=DormFlow
Jwt__Audience=DormFlow.Client

# ---------- ฐานข้อมูล ----------
# เปิดไว้ (true) เพื่อความสะดวกตอนรันครั้งแรกหรือรันอินสแตนซ์เดียว
# ปิด (false) แล้วรัน dotnet ef database update แยกก่อน deploy เมื่อรันหลายอินสแตนซ์พร้อมกัน
Database__AutoMigrate=true

# ---------- CORS ----------
# ระบุ Origin ที่อนุญาตทีละรายการ ระบบจะไม่ยอมสตาร์ตใน Production ถ้าไม่ได้ตั้งค่าไว้เลย
Cors__AllowedOrigins__0=https://app.dormflow.local

# ---------- Rate Limiting ----------
RateLimiting__Enabled=true
RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60

# ---------- ข้อมูลผู้ดูแลระบบเริ่มต้น ----------
# ถ้าเว้นว่างไว้ ระบบจะข้ามการสร้างบัญชีนี้ตอนสตาร์ต (ดู DatabaseSeeder)
SEED_ADMIN_EMAIL=admin@dormflow.local
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
