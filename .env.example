# ສຳເນົາໄຟລ໌ນີ້ເປັນ .env ຈາກນັ້ນປ່ຽນຄ່າໃຫ້ກົງກັບສະພາບແວດລ້ອມຂອງເຈົ້າ
#   cp .env.example .env
# ຫ້າມ commit ໄຟລ໌ .env ເຂົ້າ repository

# ---------- PostgreSQL ----------
POSTGRES_DB=dormflow
POSTGRES_USER=dormflow
# ຕັ້ງລະຫັດຜ່ານທີ່ເຂັ້ມແຂງກ່ອນທີ່ຈະໃຊ້ມັນ
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

# ---------- DormFlow API ພາສາລາວ ----------
# ຊື່ເຈົ້າພາບ dormflow-postgres ແມ່ນຊື່ service ໃນເຄືອຂ່າຍຂອງ docker compose
ConnectionStrings__DefaultConnection=Host=dormflow-postgres;Port=5432;Database=dormflow;Username=dormflow;Password=change-this-password

ASPNETCORE_ENVIRONMENT=Production
API_HTTP_PORT=8080

# ---------- Reverse proxy ----------
# ກຳນົດ IP ຂອງ reverse proxy ທີ່ຢູ່ໜ້າ API; ປ່ອຍຫວ່າງຖ້າບໍ່ໄດ້ໃຊ້ proxy
ForwardedHeaders__KnownProxies__0=

# ---------- JWT ----------
# ລະຫັດເຊັນຊື່ Access Token ຢ່າງໜ້ອຍຕ້ອງມີຄວາມຍາວ 32 ຕົວອັກສອນໃຝ່ແລະແບບສຸ່ມທຸກຄັ້ງ ຢ່າໃຊ້ຄ່າຕົວຢ່າງນີ້ແທ້ໆ
#   openssl rand -base64 48
Jwt__SigningKey=change-this-to-a-long-random-value-at-least-32-characters
Jwt__Issuer=DormFlow
Jwt__Audience=DormFlow.Client

# ---------- ຖານຂໍ້ມູນ ----------
# ເປີດ (true) ເພື່ອຄວາມສະດວກໃນເວລາແລ່ນຄັ້ງທໍາອິດຫຼືແລ່ນຕົວຢ່າງດຽວ
# ປິດ (false) ແລ້ວແລ່ນ dotnet ef database update ແຍກກ່ອນ deploy ເມື່ອແລ່ນຫຼາຍຕົວຢ່າງພ້ອມໆກັນ
Database__AutoMigrate=true

# ---------- CORS ----------
# ລະບຸ Origin ອະນຸຍາດຢ່າງໜ້ອຍໜຶ່ງຄ່າ; ລະບົບຈະບໍ່ເລີ່ມຖ້າບໍ່ໄດ້ຕັ້ງໄວ້
Cors__AllowedOrigins__0=https://app.dormflow.local

# ---------- Email ----------
# Production ຕ້ອງໃຊ້ SMTP; PickupDirectory ໃຊ້ໄດ້ສະເພາະ Development/Testing
Email__Provider=Smtp
Email__FromAddress=no-reply@dormflow.local
Email__FromName=DormFlow
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__SmtpUseSsl=true
Email__SmtpUsername=change-this-username
Email__SmtpPassword=change-this-password

# ---------- Rate Limiting ----------
RateLimiting__Enabled=true
RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60

# ---------- ຂໍ້ມູນຜູ້ເບິ່ງແຍງລະບົບເລີ່ມຕົ້ນ ----------
# ຖ້າປ່ອຍຫວ່າງໄວ້, ລະບົບຈະຂ້າມການສ້າງບັນຊີນີ້ໃນເວລາເລີ່ມຕົ້ນ (ສັງເກດເບິ່ງ DatabaseSeeder)
SEED_ADMIN_EMAIL=admin@dormflow.local
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
