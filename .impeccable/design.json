  "narrative": {
    "northStar": "The Working Desk",
    "overview": "DormFlow uses the working-desk direction already established for daily administration. Warm off-white surroundings, forest-green navigation and white working surfaces support dense, readable Thai forms and tables. The interface is quiet and practical, with clear actions and restrained visual emphasis.\n\nPersistent desktop navigation and a compact expandable mobile menu preserve the same operational structure. Figures use a distinct numeral face, while status text accompanies colored dots. This document records the implemented system in web/src/styles.css, Forms.jsx and App.jsx; frontmatter is normative for the reusable values it contains.",
    "keyCharacteristics": [
      "Thai-first labels and self-hosted interface fonts.",
      "Forest-green navigation with warm white working surfaces.",
      "Bordered panels and precise table dividers without decorative shadows.",
      "Text-backed status colors and conspicuous keyboard focus.",
      "Responsive layouts, reduced-motion support and printable details."
    ],
    "rules": [
      {
        "name": "The Text and Color Rule",
        "body": "Status indicators always retain a readable state label beside the colored dot.",
        "section": "colors"
      },
      {
        "name": "The Comparable Figures Rule",
        "body": "Financial metrics and table values use tabular numerals so amounts remain easy to compare.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and tonal surfaces for ordinary containers; preserve shadow emphasis for the existing field-focus treatment.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** retain Thai labels, visible field labels and the established font pairing.",
      "**Do** accompany status colors with readable text.",
      "**Do** keep financial figures tabular and operational surfaces flat.",
      "**Do** preserve keyboard focus, reduced-motion behavior and horizontally scrollable tables.",
      "**Do** reuse the shared panel, field and button patterns before adding visual variants."
    ],
    "donts": [
      "**Don't** invent business figures or imply unavailable payment integrations.",
      "**Don't** add a currency symbol until the product establishes the currency.",
      "**Don't** replace quiet status dots with color-only signals.",
      "**Don't** add decorative elevation to ordinary working panels.",
      "**Don't** treat chart-specific color arrays as a universal mapping of room status to color."
    ]
  }
}
